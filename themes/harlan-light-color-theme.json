    "minimap.findMatchHighlight": "#eab30866",
    "minimap.errorHighlight": "#dc2626",
    "minimapSlider.background": "#71716024",
    "minimapSlider.hoverBackground": "#71716038",
    "minimapSlider.activeBackground": "#7171604d",

    "//links": "===== Text links & keybindings =====",
