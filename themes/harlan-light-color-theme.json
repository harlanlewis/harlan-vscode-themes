    "method": "#be185d",
    "macro": "#be185d",
    "decorator": "#be185d",
    "string": "#166534",
    "number": "#9a3412",
    "regexp": "#a16207",
    "variable": "#18181a",
    "variable.readonly": "#9a3412",
    "parameter": "#4b4b47",
