    "textPreformat.foreground": "#be185d",
    "textBlockQuote.background": "#f9f3e9",
    "textBlockQuote.border": "#e2e1dd",
    "textCodeBlock.background": "#f1ece3",
    "textSeparator.foreground": "#e2e1dd",
    "keybindingLabel.background": "#f1ece3",
    "keybindingLabel.foreground": "#4b4b47",
    "keybindingLabel.border": "#e2e1dd",
