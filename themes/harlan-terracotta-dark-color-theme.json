  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9a9a86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Plain text / variables — weight and space, not color",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable variable"
      ],
      "settings": {
        "foreground": "#e9e5d6"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#c3c1b0"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#e08a5c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, storage, control, modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#d9744f"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#c3c1b0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a9bd6b"
      }
    },
    {
      "name": "String escapes & template expressions",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#d6a45f"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#cbab5a"
      }
    },
    {
      "name": "Numbers, constants, booleans, language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#d6a45f"
      }
    },
    {
      "name": "Other constants (enums, symbols)",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d6a45f"
      }
    },
    {
      "name": "Functions & methods — the name's hue",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6db3a2"
      }
    },
    {
      "name": "Decorators & annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#6db3a2"
      }
    },
    {
      "name": "Types, classes, interfaces, namespaces — tag intent",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#8fb0c4"
      }
    },
    {
      "name": "Built-in / support types & constants",
      "scope": [
        "support.type.primitive",
        "support.constant",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#8aa3c9"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#e9e5d6"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d6a45f"
      }
    },
    {
      "name": "HTML/XML tags — tag intent (steel)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8fb0c4"
      }
    },
    {
      "name": "HTML/JSX attribute names — the mark hue (tag / attr / value)",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#6db3a2"
      }
    },
    {
      "name": "JSX component names",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#8fb0c4"
      }
    },
    {
      "name": "CSS selectors — classes & ids",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8fb0c4"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#e9e5d6"
      }
    },
    {
      "name": "CSS property values & keywords",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#d6a45f"
      }
    },
    {
      "name": "Tag / element (Markdown, misc)",
      "scope": [
        "meta.tag",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#e9e5d6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e2725b"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d6a45f",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8fb0c4"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#8fb0c4"
      }
    },
    {
      "name": "Markdown headings — fg bold (in-article heads rest fg-bold)",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#e9e5d6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e9e5d6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e9e5d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code — the mark hue (fenced BLOCKS stay default fg)",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#e08a5c"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#8fb0c4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link text / labels",
      "scope": [
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#d9744f"
      }
    },
    {
      "name": "Markdown blockquote — muted, like a #spark quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9a9a86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list markers — muted (bullets are neutral)",
      "scope": [
        "markup.list punctuation.definition.list.begin",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#9a9a86"
      }
    },
    {
      "name": "Markdown inserted (diff-in-md)",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a9bd6b"
      }
    },
    {
      "name": "Markdown deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e2725b"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#d9744f"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#9a9a86",
      "fontStyle": "italic"
    },
    "keyword": "#d9744f",
    "type": "#8fb0c4",
    "class": "#8fb0c4",
    "interface": "#8fb0c4",
    "enum": "#8fb0c4",
    "typeParameter": "#8fb0c4",
    "namespace": "#8fb0c4",
    "struct": "#8fb0c4",
    "function": "#6db3a2",
    "method": "#6db3a2",
    "macro": "#6db3a2",
    "decorator": "#6db3a2",
    "string": "#a9bd6b",
    "number": "#d6a45f",
    "regexp": "#cbab5a",
    "variable": "#e9e5d6",
    "variable.readonly": "#d6a45f",
    "parameter": "#c3c1b0",
    "property": "#e9e5d6",
    "property.readonly": "#d6a45f",
    "enumMember": "#d6a45f",
    "event": "#6db3a2",
    "operator": "#c3c1b0",
    "*.defaultLibrary": "#8aa3c9",
