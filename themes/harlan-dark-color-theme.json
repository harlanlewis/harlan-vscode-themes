  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8c8b86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Plain text / variables — weight and space, not color",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable variable"
      ],
      "settings": {
        "foreground": "#e7e5e0"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#afaea9"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#f472b6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, storage, control, modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#afaea9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "String escapes & template expressions",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#eab308"
      }
    },
    {
      "name": "Numbers, constants, booleans, language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Other constants (enums, symbols)",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Functions & methods — the name's hue",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Decorators & annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Types, classes, interfaces, namespaces — tag intent",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#629bc6"
      }
    },
    {
      "name": "Built-in / support types & constants",
      "scope": [
        "support.type.primitive",
        "support.constant",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#7e99fc"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#e7e5e0"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "HTML/XML tags — tag intent (steel)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#629bc6"
      }
    },
    {
      "name": "HTML/JSX attribute names — the mark hue (tag / attr / value)",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "JSX component names",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#629bc6"
      }
    },
    {
      "name": "CSS selectors — classes & ids",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#629bc6"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#e7e5e0"
      }
    },
    {
      "name": "CSS property values & keywords",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "name": "Tag / element (Markdown, misc)",
      "scope": [
        "meta.tag",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#e7e5e0"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#eab308",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#629bc6"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#629bc6"
      }
    },
    {
      "name": "Markdown headings — fg bold (in-article heads rest fg-bold)",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#e7e5e0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e7e5e0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e7e5e0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code — the mark hue (fenced BLOCKS stay default fg)",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#629bc6",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link text / labels",
      "scope": [
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "name": "Markdown blockquote — muted, like a #spark quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8c8b86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list markers — muted (bullets are neutral)",
      "scope": [
        "markup.list punctuation.definition.list.begin",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#8c8b86"
      }
    },
    {
      "name": "Markdown inserted (diff-in-md)",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Markdown deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#a78bfa"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#8c8b86",
      "fontStyle": "italic"
    },
    "keyword": "#a78bfa",
    "type": "#629bc6",
    "class": "#629bc6",
    "interface": "#629bc6",
    "enum": "#629bc6",
    "typeParameter": "#629bc6",
    "namespace": "#629bc6",
    "struct": "#629bc6",
    "function": "#f472b6",
    "method": "#f472b6",
    "macro": "#f472b6",
    "decorator": "#f472b6",
    "string": "#4ade80",
    "number": "#fb923c",
    "regexp": "#eab308",
    "variable": "#e7e5e0",
    "variable.readonly": "#fb923c",
    "parameter": "#afaea9",
    "property": "#e7e5e0",
    "property.readonly": "#fb923c",
    "enumMember": "#fb923c",
    "event": "#f472b6",
    "operator": "#afaea9",
    "*.defaultLibrary": "#7e99fc",
    "selfKeyword": {
      "foreground": "#f472b6",
      "fontStyle": "italic"
    }
  }
}
