    "terminal.ansiMagenta": "#be185d",
    "terminal.ansiCyan": "#38759d",
    "terminal.ansiWhite": "#71716e",
    "terminal.ansiBrightBlack": "#9d9991",
    "terminal.ansiBrightRed": "#ef4444",
    "terminal.ansiBrightGreen": "#16a34a",
    "terminal.ansiBrightYellow": "#ea580c",
    "terminal.ansiBrightBlue": "#38759d",
    "terminal.ansiBrightMagenta": "#db2777",
    "terminal.ansiBrightCyan": "#629bc6",
    "terminal.ansiBrightWhite": "#4b4b47",

    "//git": "===== Git decorations =====",
