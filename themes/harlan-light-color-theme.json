  "//tokenColors": "===== Syntax: the site's intent accents mapped onto code. violet=keywords, fuchsia=names/functions, steel=types/tags, green=strings, orange=numbers/constants, red=invalid, muted=comments. =====",
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#71716e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Plain text / variables — weight and space, not color",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable variable"
      ],
      "settings": {
        "foreground": "#18181a"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#4b4b47"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#be185d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, storage, control, modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#4b4b47"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "String escapes & template expressions",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#a16207"
      }
    },
    {
      "name": "Numbers, constants, booleans, language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Other constants (enums, symbols)",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Functions & methods — the name's hue",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "Decorators & annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "Types, classes, interfaces, namespaces — tag intent",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#38759d"
      }
    },
    {
      "name": "Built-in / support types & constants",
      "scope": [
        "support.type.primitive",
        "support.constant",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#0f36bd"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#18181a"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "HTML/XML tags — tag intent (steel)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#38759d"
      }
    },
    {
      "name": "HTML/JSX attribute names — fuchsia (tag steel / attr fuchsia / value green)",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "JSX component names",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#38759d"
      }
    },
    {
      "name": "CSS selectors — classes & ids",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#38759d"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#18181a"
      }
    },
    {
      "name": "CSS property values & keywords",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Tag / element (Markdown, misc)",
      "scope": [
        "meta.tag",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#18181a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a16207",
        "fontStyle": "strikethrough"
      }
    },

    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#38759d"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#38759d"
      }
    },

    {
      "name": "Markdown headings — fg bold (site: in-article heads rest fg-bold; violet is for nav section links, not doc headings)",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#18181a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#18181a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#18181a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code — fuchsia (the mark hue; owner's call to lean into it). Fenced/raw BLOCKS stay default fg — a whole slab of fuchsia was the bug, one token is the accent.",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#38759d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link text / labels",
      "scope": [
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "name": "Markdown blockquote — muted, like a #spark quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#71716e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list markers — muted (site: bullets are neutral, not accented)",
      "scope": [
        "markup.list punctuation.definition.list.begin",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#71716e"
      }
    },
    {
      "name": "Markdown inserted / deleted (diff-in-md)",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "Markdown deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#991b1b"
      }
    },

    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    }
  ],

  "//semanticTokenColors": "===== Semantic tokens (LSP) mirror the TextMate mapping =====",
  "semanticTokenColors": {
    "comment": {
      "foreground": "#71716e",
