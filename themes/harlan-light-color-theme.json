    "panelInput.border": "#e2e1dd",

    "terminal.background": "#fffaef",
    "terminal.foreground": "#18181a",
    "terminalCursor.foreground": "#db2777",
    "terminalCursor.background": "#fffaef",
    "terminal.selectionBackground": "#eab30845",
    "terminal.border": "#e2e1dd",
