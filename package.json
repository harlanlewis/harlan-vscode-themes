{
  "name": "harlan-vscode-themes",
  "displayName": "Harlan Themes",
  "description": "Calm, warm, monospace-minded VS Code & Cursor themes derived from harlanlewis.com — weight and space over color, one restrained palette of intent accents.",
  "version": "1.0.0",
  "publisher": "harlanlewis",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "light",
    "warm",
    "minimal",
    "monospace",
    "calm"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Harlan Light",
        "uiTheme": "vs",
        "path": "./themes/harlan-light-color-theme.json"
      },
      {
        "label": "Harlan Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/harlan-dark-color-theme.json"
      },
      {
        "label": "Harlan Terminal (Green)",
        "uiTheme": "vs-dark",
        "path": "./themes/harlan-terminal-green-color-theme.json"
      },
      {
        "label": "Harlan Terminal (Amber)",
        "uiTheme": "vs-dark",
        "path": "./themes/harlan-terminal-amber-color-theme.json"
      }
    ]
  }
}
