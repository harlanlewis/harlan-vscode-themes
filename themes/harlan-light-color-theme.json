{
  "$schema": "vscode://schemas/color-theme",
  "name": "Harlan Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "//": "===== Neutrals: warm off-white bg (#fffaef), near-black fg (#18181a), flat chrome. Hierarchy from weight and space, not color. =====",

    "foreground": "#4b4b47",
    "descriptionForeground": "#71716e",
    "errorForeground": "#dc2626",
    "focusBorder": "#7c3aed80",
    "selection.background": "#eab30840",
    "widget.border": "#e2e1dd",
    "widget.shadow": "#1818140f",
    "icon.foreground": "#71716e",
    "sash.hoverBorder": "#7c3aed80",

    "//editor": "===== Editor =====",
    "editor.background": "#fffaef",
    "editor.foreground": "#18181a",
    "editorLineNumber.foreground": "#c7c2b8",
    "editorLineNumber.activeForeground": "#71716e",
    "editorCursor.foreground": "#db2777",
    "editorCursor.background": "#fffaef",
    "editor.selectionBackground": "#eab30845",
    "editor.selectionHighlightBackground": "#eab30826",
    "editor.inactiveSelectionBackground": "#eab3081f",
    "editor.wordHighlightBackground": "#7c3aed1a",
    "editor.wordHighlightStrongBackground": "#7c3aed26",
    "editor.findMatchBackground": "#eab30866",
    "editor.findMatchHighlightBackground": "#eab30838",
    "editor.findRangeHighlightBackground": "#7c3aed14",
    "editor.hoverHighlightBackground": "#7c3aed14",
    "editor.lineHighlightBackground": "#18181408",
    "editor.lineHighlightBorder": "#00000000",
    "editorLink.activeForeground": "#7c3aed",
    "editor.rangeHighlightBackground": "#7c3aed10",
    "editorWhitespace.foreground": "#e2e1dd",
    "editorIndentGuide.background1": "#f1ebe0",
    "editorIndentGuide.activeBackground1": "#dad5ca",
    "editorRuler.foreground": "#f1ebe0",
    "editorBracketMatch.background": "#7c3aed1f",
    "editorBracketMatch.border": "#7c3aed66",
    "editorCodeLens.foreground": "#9d9991",
    "editorInlayHint.foreground": "#9d9991",
